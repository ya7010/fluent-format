{
  "name": "vscode-fluent-format",
  "displayName": "Project Fluent Format",
  "version": "0.1.0",
  "description": "Format and sort Fluent (.ftl) translation files in VSCode",
  "publisher": "yassun7010",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ya7010/fluent-format"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Formatters",
    "Programming Languages"
  ],
  "keywords": [
    "fluent",
    "ftl",
    "formatter",
    "localization",
    "l10n",
    "i18n",
    "mozilla",
    "projectfluent"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:fluent"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fluent",
        "extensions": [
          ".ftl"
        ],
        "aliases": [
          "Fluent",
          "fluent"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "Fluent Format",
      "properties": {
        "fluentFormat.sortOnFormat": {
          "type": "boolean",
          "default": false,
          "description": "Sort messages alphabetically when formatting"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "mkdir -p dist && vsce package --no-dependencies",
    "install:vscode": "bun run package && code --install-extension dist/extension.vsix",
    "install:cursor": "bun run package && cursor --install-extension dist/extension.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "typescript": "^5.9.3",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "fluent-format": "file:.."
  }
}