{
  "name": "fluent-format",
  "version": "0.1.0",
  "description": "A CLI tool and library to format and sort Fluent (.ftl) translation files",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/fluent-format"
  },
  "keywords": [
    "fluent",
    "ftl",
    "formatter",
    "localization",
    "l10n",
    "i18n"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "bin": {
    "fluent-format": "./src/cli.ts"
  },
  "scripts": {
    "format": "biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@fluent/syntax": "^0.19.0",
    "commander": "^14.0.3"
  }
}
